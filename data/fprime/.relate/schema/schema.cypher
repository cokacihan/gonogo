CREATE RANGE INDEX `document_id` FOR (n:`Document`) ON (n.`id`);
CREATE VECTOR INDEX `entity_embedding` FOR (n:`Entity`) ON (n.`embedding`) OPTIONS {indexConfig: {`vector.default_search_expansion_factor`: 3.0,`vector.dimensions`: 256,`vector.hnsw.ef_construction`: 100,`vector.hnsw.m`: 16,`vector.quantization.type`: 'BINARY',`vector.similarity_function`: 'COSINE'}};
CREATE RANGE INDEX `entity_id` FOR (n:`Entity`) ON (n.`id`);
CREATE FULLTEXT INDEX `entity_text` FOR (n:`Entity`) ON EACH [n.`text`, n.`id`] OPTIONS {indexConfig: {`fulltext.analyzer`: 'standard-no-stop-words',`fulltext.eventually_consistent`: false}};
CREATE RANGE INDEX `instance_id` FOR (n:`Instance`) ON (n.`id`);
CREATE RANGE INDEX `library_id` FOR (n:`Library`) ON (n.`id`);
CREATE RANGE INDEX `part_id` FOR (n:`Part`) ON (n.`id`);
CREATE RANGE INDEX `porttype_id` FOR (n:`PortType`) ON (n.`id`);
CREATE RANGE INDEX `requirement_id` FOR (n:`Requirement`) ON (n.`id`);
CREATE RANGE INDEX `testcase_id` FOR (n:`TestCase`) ON (n.`id`);
CREATE RANGE INDEX `testfile_id` FOR (n:`TestFile`) ON (n.`id`);
CREATE RANGE INDEX `testfunction_id` FOR (n:`TestFunction`) ON (n.`id`);
CREATE RANGE INDEX `testrun_id` FOR (n:`TestRun`) ON (n.`id`);
CREATE RANGE INDEX `verification_id` FOR (n:`Verification`) ON (n.`id`);
